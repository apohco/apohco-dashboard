{
  "name": "apohco-dashboard-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Lambda functions for the APOHCO Financial Dashboard (AWS SAM app)",
  "scripts": {
    "build": "sam build",
    "local-api": "sam local start-api",
    "deploy": "sam deploy",
    "db:migrate": "node src/db/migrate.js",
    "db:backfill-report-layouts": "node src/db/backfillReportLayouts.js",
    "test": "jest"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.3",
    "@aws-sdk/client-cognito-identity-provider": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/client-secrets-manager": "^3.699.0",
    "@aws-sdk/client-sqs": "^3.1173.0",
    "@aws-sdk/client-textract": "3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "aws-jwt-verify": "^4.0.1",
    "axios": "^1.7.7",
    "csv-parse": "^5.6.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "3.11.174",
    "pg": "^8.13.1",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "clearMocks": true
  }
}
